# --- GENERAL SETTINGS ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- CORE API SERVER ---
CORE_API_PORT=8089

# --- FRONTEND ---
FRONTEND_PORT=8501

# --- VECTOR DATABASE (QDRANT) ---
# Put it as "localhost" if you are running Qdrant locally, or "qdrant-db" if using Docker Compose with a service named "qdrant-db"
QDRANT_HOST=qdrant-db
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY="Your Qdrant API Key here"

# --- LOCAL LLM (OLLAMA) ---
# Powers the SQL agent loop. Run `ollama serve` and pull a tool-capable model.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
AGENT_MAX_STEPS=6

# --- RELATIONAL DATABASE (POSTGRES) ---
# Used by the Sentinel MCP `sql_query` tool. Synthetic e-commerce data only.
# Use "localhost" when running the MCP server outside Docker, "postgres-db"
# inside the Compose network.
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_db
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
# The read-only role the SQL tool actually connects with (least privilege).
POSTGRES_RO_USER=sentinel_ro
POSTGRES_RO_PASSWORD=sentinel_ro
# Max rows any single sql_query call may return (hard server-side cap).
POSTGRES_QUERY_ROW_LIMIT=100

# --- ADVANCED RAG ---
RAG_DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_CHUNK_MAX_TOKENS=350
RAG_CHUNK_OVERLAP_TOKENS=50
RAG_RETRIEVAL_CANDIDATES=20
RAG_TOP_K=5

# --- MODEL CACHE ---
# Docker Compose maps this path to a named volume so FastEmbed/Hugging Face
# model downloads survive container rebuilds/restarts.
HF_HOME=/app/.cache/huggingface
HF_HUB_CACHE=/app/.cache/huggingface/hub
FASTEMBED_CACHE_PATH=/app/.cache/huggingface/fastembed

# --- LLM / LANGCHAIN ---
OPENAI_API_KEY="Your OpenAI API Key here"
LANGCHAIN_API_KEY="Your LangChain API Key here"
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=AGENTIC-RAG

# --- OPENTELEMETRY ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=agentic-rag
# Local dev (Windows/Mac/Linux/WSL with native Docker): http://localhost:6006
# Docker: http://phoenix:6006
OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006
