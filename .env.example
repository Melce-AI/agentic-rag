# --- GENERAL SETTINGS ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- CORE API SERVER ---
CORE_API_PORT=8089

# --- FRONTEND ---
FRONTEND_PORT=8501

# --- REDIS (LangGraph checkpoint store) ---
# Docker: redis://redis:6379  |  local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# --- JWT / AUTH (RS256) ---
# Generate the keypair once (never commit the PEMs — keys/ is gitignored):
#   openssl genrsa -out keys/jwt_private.pem 2048
#   openssl rsa -in keys/jwt_private.pem -pubout -out keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ISSUER=agentic-rag-auth
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Phase 1 single bootstrap user (replace with a users DB in a later phase).
# AUTH_USER_PASSWORD_HASH is "salt:pbkdf2_sha256_hex" — generate with src.auth.service.hash_password
AUTH_USER_EMAIL=ece@qkare.com
AUTH_USER_PASSWORD_HASH=

# --- VECTOR DATABASE (QDRANT) ---
# Put it as "localhost" if you are running Qdrant locally, or "qdrant-db" if using Docker Compose with a service named "qdrant-db"
QDRANT_HOST=qdrant-db
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY="Your Qdrant API Key here"

# --- LOCAL LLM (OLLAMA) ---
# Powers the SQL agent loop. Run `ollama serve` and pull a tool-capable model.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
AGENT_MAX_STEPS=6

# --- RELATIONAL DATABASE (POSTGRES) ---
# Used by the Sentinel MCP `sql_query` tool. Synthetic e-commerce data only.
# Use "localhost" when running the MCP server outside Docker, "postgres-db"
# inside the Compose network.
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_db
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
# The read-only role the SQL tool actually connects with (least privilege).
POSTGRES_RO_USER=sentinel_ro
POSTGRES_RO_PASSWORD=sentinel_ro
# Max rows any single sql_query call may return (hard server-side cap).
POSTGRES_QUERY_ROW_LIMIT=100

# --- AGENT LLM ---
# Provider for the SQL agent loop: "huggingface" (free serverless API) or "ollama" (local).
LLM_PROVIDER=huggingface
# Hugging Face Inference API — get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
# Must support tool-calling on the HF router (e.g. Qwen/Qwen2.5-72B-Instruct,
# Qwen/Qwen2.5-7B-Instruct, meta-llama/Llama-3.3-70B-Instruct).
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
# Local Ollama (only if LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
AGENT_MAX_STEPS=6

# --- LANGGRAPH AGENT CHAT MODEL ---
# Provider-agnostic chat model for the Researcher/Analyst/Auditor nodes.
# Swap providers by changing ONLY this string ("provider:model"). The API key
# is read from the standard env var below automatically.
#   free/local : ollama:llama3.1:8b   |  anthropic : anthropic:claude-opus-4-8
#   openai     : openai:gpt-4o
AGENT_MODEL=ollama:llama3.1:8b
AGENT_TEMPERATURE=0.0
# Loop brakes: max Auditor->Researcher revisions (business) + LangGraph's hard
# step cap per run (infrastructure).
AGENT_MAX_REVISIONS=2
AGENT_RECURSION_LIMIT=25

# --- ADVANCED RAG ---
RAG_DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_CHUNK_MAX_TOKENS=350
RAG_CHUNK_OVERLAP_TOKENS=50
RAG_RETRIEVAL_CANDIDATES=20
RAG_TOP_K=5

# --- MODEL CACHE ---
# Docker Compose maps this path to a named volume so FastEmbed/Hugging Face
# model downloads survive container rebuilds/restarts.
HF_HOME=/app/.cache/huggingface
HF_HUB_CACHE=/app/.cache/huggingface/hub
FASTEMBED_CACHE_PATH=/app/.cache/huggingface/fastembed

# --- LLM / LANGCHAIN ---
OPENAI_API_KEY="Your OpenAI API Key here"
ANTHROPIC_API_KEY="Your Anthropic API Key here"
LANGCHAIN_API_KEY="Your LangChain API Key here"
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=AGENTIC-RAG

# --- OPENTELEMETRY ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=agentic-rag
# Local dev (Windows/Mac/Linux/WSL with native Docker): http://localhost:6006
# Docker: http://phoenix:6006
OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006
